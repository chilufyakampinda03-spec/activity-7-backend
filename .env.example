# Copy to .env for local use.
PORT=3000
# Comma-separated frontend origins allowed by CORS (leave empty to allow any origin while testing)
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Leave DATABASE_URL empty locally -> a SQLite file (records.db) is used.
# On Render, paste your PostgreSQL "Internal Database URL" here for persistent storage.
DATABASE_URL=
# Details shown on the GET / guide page
PROJECT_NAME=Library Service Requests
STUDENT_NAME=Your Name
STUDENT_NUMBER=202407715
SYSTEM_DESCRIPTION=Students log and track library requests for book searches, borrowing support and account help.
